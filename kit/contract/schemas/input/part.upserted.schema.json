{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackathon-inventario.local/schemas/input/part.upserted.schema.json",
  "title": "part.upserted",
  "description": "Llave (key): \"part:\" + part_id, ej. \"part:305\". Tópico: shop.catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source",
    "key",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "part.upserted"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "source": {
      "const": "shop-floor"
    },
    "key": {
      "$ref": "../common.schema.json#/$defs/non_empty_string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "sku",
        "name",
        "family",
        "group",
        "subgroup",
        "unit",
        "image_url",
        "active"
      ],
      "properties": {
        "part_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "sku": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/non_empty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "$ref": "../common.schema.json#/$defs/non_empty_string"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subgroup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "../common.schema.json#/$defs/unit"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        }
      }
    }
  }
}
