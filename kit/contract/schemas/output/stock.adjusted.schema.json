{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackathon-inventario.local/schemas/output/stock.adjusted.schema.json",
  "title": "stock.adjusted",
  "description": "Llave (key): \"part:\" + part_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source",
    "key",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "stock.adjusted"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "source": {
      "const": "inventory"
    },
    "key": {
      "$ref": "../common.schema.json#/$defs/non_empty_string"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "part_id",
        "location_id",
        "delta",
        "reason"
      ],
      "properties": {
        "part_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "location_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "delta": {
          "type": "integer",
          "not": {
            "const": 0
          }
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/non_empty_string"
        }
      }
    }
  }
}
