{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackathon-inventario.local/schemas/output/stock.issued.schema.json",
  "title": "stock.issued",
  "description": "Llave (key): código de la orden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source",
    "key",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "stock.issued"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "source": {
      "const": "inventory"
    },
    "key": {
      "$ref": "../common.schema.json#/$defs/non_empty_string"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "work_order_id",
        "part_id",
        "location_id",
        "quantity",
        "issued_by"
      ],
      "properties": {
        "work_order_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "part_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "location_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "quantity": {
          "$ref": "../common.schema.json#/$defs/quantity"
        },
        "issued_by": {
          "type": [
            "integer",
            "string"
          ],
          "minLength": 1
        }
      }
    }
  }
}
