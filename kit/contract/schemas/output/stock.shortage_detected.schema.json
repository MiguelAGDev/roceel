{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackathon-inventario.local/schemas/output/stock.shortage_detected.schema.json",
  "title": "stock.shortage_detected",
  "description": "Llave (key): código de la orden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source",
    "key",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "stock.shortage_detected"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "source": {
      "const": "inventory"
    },
    "key": {
      "$ref": "../common.schema.json#/$defs/non_empty_string"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "work_order_id",
        "part_id",
        "name",
        "missing_quantity",
        "inspection_item_id"
      ],
      "properties": {
        "work_order_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "part_id": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "$ref": "../common.schema.json#/$defs/non_empty_string"
        },
        "missing_quantity": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "inspection_item_id": {
          "$ref": "../common.schema.json#/$defs/id"
        }
      }
    }
  }
}
